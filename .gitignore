# ==========================================
# Python / Backend Ignores
# ==========================================
# Virtual environments
venv/
.venv/
ENV/
env/
backend/venv/

# Python compiled bytecode & caches
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class

# User upload & generated files
backend/uploads/
backend/generated_docs/
generated_docs/
uploads/

# Environment secrets
.env
.env.*
!.env.example

# Database files
*.sqlite3
*.db

# Python testing & coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/


# ==========================================
# Node.js / React Frontend Ignores
# ==========================================
# Dependency directories
node_modules/
frontend/node_modules/

# Production build outputs
frontend/build/
frontend/dist/
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment settings
frontend/.env*.local
frontend/.env


# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db